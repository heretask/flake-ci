+def write_alpine_projection(sbom_path, out_path, release):
+    """Write the SBOM with each versioned component relabelled as an apk
+    package of the given Alpine release.
+
+    grype then matches the components against Alpine's security database,
+    which often lists a fixed version before NVD has analysed the CVE. The
+    match is by package name only, so it is a second opinion, not proof.
+    """
+    with open(sbom_path, encoding="utf-8") as infile:
+        sbom = json.load(infile)
+    components = list(sbom.get("components", []))
+    root = sbom.get("metadata", {}).get("component")
+    if isinstance(root, dict):
+        components.append(root)
+    for component in components:
+        component.pop("cpe", None)
+        name = component.get("name")
+        version = component.get("version")
+        if not name or not version:
+            continue
+        component["version"] = f"{version}{ALPINE_RELEASE_SUFFIX}"
+        component["purl"] = (
+            f"pkg:apk/alpine/{name}@{component['version']}?distro=alpine-{release}"
+        )
+    with open(out_path, "w", encoding="utf-8") as outfile:
+        json.dump(sbom, outfile)
+
+
